# Public venue-engine origin. The browser fetches this directly so CORS is exercised.
NEXT_PUBLIC_VENUE_ENGINE_URL=https://venuekit-ashen.vercel.app

# Google Maps (optional, #17). Set both to render the map with Google; leave
# the key empty to keep the Leaflet + OpenStreetMap fallback. Browser key must
# be referrer- and API-restricted (see #16). Map ID falls back to DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
